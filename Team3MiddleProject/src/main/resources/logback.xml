<configuration>
<appender name="stdout" class="ch.qos.logback.core.ConsoleAppender">
<encoder>
<pattern>%5level [%thread] - %msg%n</pattern>
</encoder>
</appender>
<logger name="com.yedam.mapper.BoardMapper">
<level value="debug"/>
</logger>
<logger name="com.yedam.mapper.ReplyMapper">
<level value="debug"/>
</logger>
<!-- 
<logger name="com.yedam.mapper.ProductListMapper">
<level value="debug"/>
</logger>
 -->
<root level="error">
<appender-ref ref="stdout"/>
</root>
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
