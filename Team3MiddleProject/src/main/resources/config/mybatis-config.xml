<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>

  <settings>
    <setting name="mapUnderscoreToCamelCase" value="true"/>
    <setting name="jdbcTypeForNull" value="NULL" />
  </settings>

  <typeAliases>
  	<typeAlias alias= "product" type="com.yedam.vo.ProductVO"/>
  	<typeAlias alias= "review" type="com.yedam.vo.ReviewVO"/>
  	<typeAlias alias= "order" type="com.yedam.vo.OrderVO"/>
    <!-- <typeAlias alias=" " type=""/>  -->
    <typeAlias alias="member" type = "com.yedam.vo.MemberVO"/>
    <typeAlias alias="cp" type="com.yedam.vo.CartProductVO"/>
    <typeAlias alias="om" type="com.yedam.vo.OrderMemberVO"/>
    <typeAlias alias="search" type="com.yedam.vo.SearchVO"/>
    <typeAlias alias="ac" type="com.yedam.vo.AddCartVO"/>
  </typeAliases>

  <environments default="development">
    <environment id="development">
      <transactionManager type="JDBC"/>
      <dataSource type="POOLED">
        <property name="driver" value="oracle.jdbc.driver.OracleDriver"/>
        <property name="url" value="jdbc:oracle:thin:@192.168.0.51"/> <!-- localhost --> <!-- 192.168.0.51 -->
        <property name="username" value="dev"/>
        <property name="password" value="dev"/>
      </dataSource>
    </environment>
  </environments>

  <mappers>
  	<mapper resource="com/yedam/mapper/MemberMapper.xml"/>
    <mapper resource="com/yedam/mapper/DetailMapper.xml"/>
    <mapper resource="com/yedam/mapper/ReviewMapper.xml"/>
    <mapper resource="com/yedam/mapper/ProductListMapper.xml"/>
  	<mapper resource="com/yedam/mapper/CartMapper.xml"/>
  	<mapper resource="com/yedam/mapper/OrderMapper.xml"/>
  	<mapper resource="com/yedam/mapper/SaleProductMapper.xml"/>
  	<mapper resource="com/yedam/mapper/SearchMapper.xml"/>
  	<mapper resource="com/yedam/mapper/SalesMapper.xml"/>
  </mappers>

</configuration>